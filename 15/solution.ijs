NB. )

NB. fn=:{{
NB.     tar=:(+/ y)%x
NB.     for_k. i. # y do.
NB.         chunks=:(k comb #y){y
NB.         ok=:I.tar=(+/"1)chunks
NB.         if.#ok do.<./*/"1 ok{chunks return. end.
NB.     end. 
NB. }}


