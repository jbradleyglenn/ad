NB. fn =: {{
NB.     f =. y
NB.     best =. _
NB.     while. #f do.
NB.         f =. f -"1 x*1 0 0 0 0 0 0                      NB. x is hard mode
NB.         f =. (0 < 0 {"1 f) # f                          NB. player died
NB.         f =. eff f
NB.         best =. best <. <./ 6 {"1 (0 >: 2 {"1 f) # f    NB. poison kill
NB.         f =. (0 < 2 {"1 f) # f
NB.         f =. ,/ f +"1/ spells
NB.         ok =. (0 <: 1 {"1 f) *. *./"1 (6 6 5) >:"1 (3 4 5 {"1 f)
NB.         f =. ok # f
NB.         best =. best <. <./ 6 {"1 (0 >: 2 {"1 f) # f    NB. missile/drain kill
NB.         f =. (0 < 2 {"1 f) # f
NB.         NB. boss turn
NB.         armor =. 7 * 0 < 3 {"1 f                         NB. before timers tick
NB.         f =. eff f
NB.         best =. best <. <./ 6 {"1 (0 >: 2 {"1 f) # f    NB. poison kill
NB.         f =. (0 < 2 {"1 f) # f - (1 >. bdamage - armor) */ 1 0 0 0 0 0 0
NB.         f =. (0 < 0 {"1 f) # f                           NB. player died
NB.         f =. ~. (best > 6 {"1 f) # f                     NB. prune + dedupe
NB.     end.
