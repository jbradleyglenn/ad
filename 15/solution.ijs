NB. 9
i9 =:'Faerun to Norrath = 129ZFaerun to Tristram = 58ZFaerun to AlphaCentauri = 13ZFaerun to Arbre = 24ZFaerun to Snowdin = 60ZFaerun to Tambi = 71ZFaerun to Straylight = 67ZNorrath to Tristram = 142ZNorrath to AlphaCentauri = 15ZNorrath to Arbre = 135ZNorrath to Snowdin = 75ZNorrath to Tambi = 82ZNorrath to Straylight = 54ZTristram to AlphaCentauri = 118ZTristram to Arbre = 122ZTristram to Snowdin = 103ZTristram to Tambi = 49ZTristram to Straylight = 97ZAlphaCentauri to Arbre = 116ZAlphaCentauri to Snowdin = 12ZAlphaCentauri to Tambi = 18ZAlphaCentauri to Straylight = 91ZArbre to Snowdin = 129ZArbre to Tambi = 53ZArbre to Straylight = 40ZSnowdin to Tambi = 15ZSnowdin to Straylight = 99ZTambi to Straylight = 70Z'
L =: ~. ,(0 2{ [:;:]);._2 i9
D =:(+ |:) (".@>@{:@;:;._2 i9) (<(L i. 0 2{ ;:);._2 i9)} (2$#L)$0
P =:(A.~&i. !)#L
o =:<./+/@(D{~ [:< 2 ]\])"1 P
oo =:>./+/@(D{~ [:< 2 ]\])"1 P
echo 9;o;oo

NB. 10
i10 =:'1113122113'
NB. o =:# ,@((#,{.);.1~ 1, }.~:}:)^:40 "."0 i10
NB. oo =:# ,@((#,{.);.1~ 1, }.~:}:)^:50 "."0 i10
echo 10;o;oo

NB. 11
i11 =:'cqjxjnds'
c1 =:{{0 1 2 e.3(- {.)\ LC i.y}}
c2 =:{{-.+./'iol'e.~y}}
c3 =:{{1<+/(LC,.LC)+./@E."1 y}}
fn =:{{i=:(8$26)#. LC i. y while.1 do. if.(c1*c2*c3)p=:LC{~ (8$26)#: i=:1+i do. p return. end. end.}}
NB. o =: fn i11
NB. oo =: fn o
