NB. fn=:{{
NB.     win=:(3 :('''d1 a1 h1 d2 a2 h2''=:y';'(>.h2%1>.d1-a2)<:(>.h1%1>.d2-a1)'))
NB.     weap=:_3]\ 8 4 0 10 5 0 25 6 0 40 7 0 74 8 0
NB.     armor=:_3]\ 0 0 0 13 0 1 31 0 2 53 0 3 75 0 4 102 0 5
NB.     rings=:_3]\ 0 0 0 25 1 0 50 2 0 100 3 0 20 0 1 40 0 2 80 0 3
NB.     costs =: 0$0
NB.     'd1 a1 h1'=:0 0 100
NB.     for_choice. 5 6 7 7 #: i. 5*6*7*7 do.
NB.         'i j k l'=:choice
NB.         if. (k=l)*.(k>0) do. continue. end. 
NB.         echo i,j,k,l
NB.         sum =: (i{weap)+(j{armor)+(k{rings)+(l{rings)
NB.         if. win (1 2{sum),100 8 2 109 do. costs =: costs , 0 { sum end.
NB.     end.
NB.     <./ costs
NB. }}

