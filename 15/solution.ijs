echo 13;o;oo

NB. 14
i14 =:'Vixen can fly 8 km/s for 8 seconds, but then must rest for 53 seconds.ZBlitzen can fly 13 km/s for 4 seconds, but then must rest for 49 seconds.ZRudolph can fly 20 km/s for 7 seconds, but then must rest for 132 seconds.ZCupid can fly 12 km/s for 4 seconds, but then must rest for 43 seconds.ZDonner can fly 9 km/s for 5 seconds, but then must rest for 38 seconds.ZDasher can fly 10 km/s for 4 seconds, but then must rest for 37 seconds.ZComet can fly 3 km/s for 37 seconds, but then must rest for 76 seconds.ZPrancer can fly 9 km/s for 12 seconds, but then must rest for 97 seconds.ZDancer can fly 37 km/s for 1 seconds, but then must rest for 36 seconds.Z'
