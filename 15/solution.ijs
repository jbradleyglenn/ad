NB. NB. opcode register offset
NB. parse =: {{
NB.   w=.;:('_'(I.y='-')}y)-.',+'
NB.   (ops i.{.w),('ab'i.{.>1{w),(0".>{:w)
NB. }}
NB. prog =: parse ;._2 input

NB. run =: {{
NB.   r  =. y , 0
NB.   pc =. 0
NB.   while. pc < # prog do.
NB.     'op reg off' =. pc { prog
NB.     vv =. reg { r
NB.     select. op
NB.       case. 0 do. r =. (<. -: vv) reg} r
NB.       case. 1 do. r =. (3 * vv)   reg} r
NB.       case. 2 do. r =. (>: vv)    reg} r
NB.     end.
NB.     jump =. (op=3) +. ((op=4) *. 0 = 2|vv) +. (op=5) *. vv=1
NB.     pc =. pc + jump { 1 , off
NB.   end.
NB.   1 { r
NB. }}

NB. run 0 0

